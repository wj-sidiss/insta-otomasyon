# ===========================================================================
#  insta-otomasyon - GIZLI AYARLAR (ornek dosya)
# ---------------------------------------------------------------------------
#  1) Bu dosyayi ayni klasore ".env" adiyla KOPYALAYIN
#     (Windows PowerShell:  Copy-Item config\.env.ornek config\.env )
#  2) Asagidaki degerleri kendi bilgilerinizle doldurun.
#
#  .env dosyasi .gitignore ile korunur, asla depoya girmez.
#  Buraya gercek token yazdiktan sonra dosyayi kimseyle paylasmayin;
#  token, hesabiniz adina Instagram'a icerik yayinlama yetkisidir.
# ===========================================================================

# --- Facebook Sayfa erisim anahtari (Page access token) --------------------
# UZUN OMURLU olani kullanin. Sira: kisa omurlu kullanici tokeni ->
# /oauth/access_token (fb_exchange_token) ile uzun omurlu kullanici tokeni ->
# /me/accounts cagrisi -> sayfanin access_token alani.
# DIKKAT: /me/accounts cagrisini KISA omurlu token ile yaparsaniz donen sayfa
# tokeni de kisa omurlu olur ve otomasyon birkac saat sonra sessizce durur.
FB_SAYFA_TOKEN=buraya_uzun_omurlu_sayfa_tokeni

# --- Instagram isletme hesabi kimligi --------------------------------------
# Bulmak icin:
#   GET /<SAYFA_ID>?fields=instagram_business_account&access_token=<SAYFA_TOKENI>
# Donen "instagram_business_account" icindeki "id" degeridir (17 haneli sayi).
IG_HESAP_ID=buraya_instagram_isletme_hesap_id

# --- Meta uygulama bilgileri (istege bagli ama tavsiye edilir) -------------
# Sadece token gecerliligini kontrol etmek icin kullanilir:
#   GET /debug_token?input_token=<TOKEN>&access_token=<APP_ID>|<APP_SECRET>
# Bos birakilirsa yayin calisir, ancak haftalik token saglik kontrolu yapilamaz.
FB_UYGULAMA_ID=
FB_UYGULAMA_SIRRI=

# --- Graph API surumu ------------------------------------------------------
# "v23.0" bicimi. Meta ornekleri surumler arasinda degisiyor; surumu burada
# sabitleyin ve yilda bir gozden gecirin. Kullanimdan kaldirilan bir surum
# otomasyonu bir gunde durdurur.
API_SURUMU=v23.0
